  padding: 6rpx 16rpx;
  margin-bottom: 16rpx;
}
.invite-card .invite-content .invite-badge .badge-icon.data-v-276ac604 {
  font-size: 20rpx;
  margin-right: 8rpx;
}
.invite-card .invite-content .invite-badge .badge-text.data-v-276ac604 {
  font-size: 22rpx;
