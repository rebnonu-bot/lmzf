}
.invite-card .invite-content .invite-desc.data-v-276ac604 {
  font-size: 26rpx;
  color: #94A3B8;
  line-height: 1.5;
}
.invite-card .invite-btn.data-v-276ac604 {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
